# Copy to .env and fill in. Never commit .env.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
ISSUER_NAME=Event Organizing Committee

# Delivery. Leave both empty for SANDBOX mode: every email is saved as an .eml file in data/outbox/.
# Option A, SMTP (Gmail: smtp.gmail.com, 587, starttls, with an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Option B, Resend API
RESEND_API_KEY=
MAIL_FROM=certificates@your-college.edu
MAIL_FROM_NAME=SealSend Certificates

# Printed into each certificate's QR code. For a live demo, use your laptop's LAN IP
# (e.g. http://192.168.1.20:8000) so a judge's phone can open it.
PUBLIC_BASE_URL=http://localhost:8000

# AI rules copilot: "auto" uses Claude when ANTHROPIC_API_KEY is set, else the offline parser.
ANTHROPIC_API_KEY=
COPILOT_ENGINE=auto

SEND_DELAY_SECONDS=0
MAX_SEND_ATTEMPTS=3
