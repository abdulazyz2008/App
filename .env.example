# Copy to .env and fill in. Never commit .env.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Leave SMTP_HOST empty to run in "outbox" mode: emails are saved as .eml files in data/outbox/.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=certificates@your-college.edu
MAIL_FROM_NAME=Event Organizing Team

# Base URL printed in the QR code / verification link on each certificate.
PUBLIC_BASE_URL=http://localhost:8000
# Pause between emails (seconds) to respect provider rate limits; retries per email.
SEND_DELAY_SECONDS=0
MAX_SEND_ATTEMPTS=3
